// tests/unit/issue-564a.frag
#version 300 es

precision highp float;
uniform float t;
out vec4 f;
float n(float t)
{
  return t+t;
}
vec2 h()
{
  float n=3.*t;
  return vec2(n+n,n);
}
void main()
{
  f=vec4(n(t)+n(2.*t),h(),0);
}

// tests/unit/issue-564b.frag
#version 300 es

precision highp float;
uniform float t;
out vec4 f;
float n()
{
  float n=4.*t;
  return n+n;
}
vec2 h()
{
  float n=5.*t;
  return vec2(n+n,n);
}
void main()
{
  f=vec4(n(),h(),0);
}
