#version 300 es

precision highp float;
out vec4 h;
float v(vec2 p)
{
  return dot(p,p);
}
float v(vec3 p)
{
  return dot(p,p);
}
float v(vec4 p)
{
  return dot(p,p);
}
float p(float p)
{
  return clamp(p,0.,1.);
}
vec2 p(vec2 p)
{
  return clamp(p,0.,1.);
}
vec3 p(vec3 p)
{
  return clamp(p,0.,1.);
}
vec4 p(vec4 p)
{
  return clamp(p,0.,1.);
}
void main()
{
  h=vec4(1,p(v(gl_FragCoord.xy/5e2)),1,1);
}
