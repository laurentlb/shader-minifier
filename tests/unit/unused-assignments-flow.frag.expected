#version 330

uniform float u;
float g;
out vec4 fragColor;
void h()
{
  g++;
}
float doWhileLoop(float x)
{
  float a=sin(x);
  h();
  a=cos(x);
  do
     x+=a;
  while(x<10.);
  return x;
}
float switchStmt(float x)
{
  float a=sin(x);
  h();
  a=cos(x);
  switch(int(x)){
    case 0:
      x=a;
      break;
    default:
      x=1.;
  }
  return x;
}
float noBranch(float x)
{
  float a=sin(x);
  g=a;
  h();
  return x+g;
}
void main()
{
  fragColor=vec4(doWhileLoop(u),switchStmt(u),noBranch(u),1);
}
