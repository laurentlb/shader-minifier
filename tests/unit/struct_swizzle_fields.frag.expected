#version 330

struct S{
  float x;
  float y;
};
struct T{
  S m;
  vec2 v;
};
uniform S s;
uniform T t;
uniform vec2 u;
out vec4 o;
S makeS()
{
  return S(1.,2.);
}
vec2 combine()
{
  return vec2(s.x,s.y);
}
vec2 dropLast()
{
  return vec2(u.y,s.x);
}
vec2 nested()
{
  return vec2(u.y,t.m.x);
}
vec2 constructor()
{
  return vec2(u.y,S(1.,2.).x);
}
vec2 call()
{
  return vec2(u.y,makeS().x);
}
vec2 swizzles()
{
  return vec2(u)+vec2(u.y,t.v);
}
void main()
{
  o=vec4(combine(),dropLast())+vec4(nested(),constructor())+vec4(call(),swizzles());
}
