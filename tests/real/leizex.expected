_leizex_frag:
	db '#extension GL_EXT_gpu_shader4:enable', 10, ''
	db 'uniform vec2 n;'
	db 'uniform float f;'
	db 'uniform sampler2D G,m,s,z;'
	db 'float t(int v)'
	db '{'
	db   'v^=v<<13;'
	db   'v=v*(v*v*15731+789221)+1376312589&2147483647;'
	db   'return float(v);'
	db '}'
	db 'float t(vec3 v,int d)'
	db '{'
	db   'ivec3 n=ivec3(floor(v));'
	db   'vec3 s=fract(v);'
	db   's=s*s*(3.-2.*s);'
	db   'd+=n.x+n.y*57+113*n.z;'
	db   'float y=mix(mix(mix(t(d),t(d+1),s.x),mix(t(d+57),t(d+58),s.x),s.y),mix(mix(t(d+113),t(d+114),s.x),mix(t(d+170),t(d+171),s.x),s.y),s.z);'
	db   'return 1.-y*(1./1073741824.);'
	db '}'
	db 'vec2 t(vec3 v)'
	db '{'
	db   'ivec3 n=ivec3(floor(v));'
	db   'vec3 s=fract(v);'
	db   'vec2 d=vec2(1);'
	db   'for(int v=-1;v<=1;v++)'
	db     'for(int y=-1;y<=1;y++)'
	db       'for(int f=-1;f<=1;f++)'
	db         '{'
	db           'int i=n.x+f+57*(n.y+y)+113*(n.z+v);'
	db           'vec3 m=vec3(float(f),float(y),float(v))-s+vec3(t(i),t(i+1217),t(i+2513))/2147483647.;'
	db           'float c=dot(m,m);'
	db           'if(c<d.x)'
	db             'd.y=d.x,d.x=c;'
	db           'else if(c<d.y)'
	db             'd.y=c;'
	db         '}'
	db   'return.25*sqrt(d);'
	db '}'
	db 'float v(vec3 v)'
	db '{'
	db   'return.5*t(v,0)+.25*t(v*2.,0)+.125*t(v*4.,0)+.0625*t(v*8.,0);'
	db '}'
	db 'float t(vec3 v,out float y)'
	db '{'
	db   'vec3 m=mod(vec3(1024)+v,1.)-.5;'
	db   'float f=sqrt(dot(m,m))-.09,s=t(4.*v,0);'
	db   'f+=.8*s;'
	db   'y=clamp(-1.5*s,0.,1.);'
	db   'vec2 d=t(16.*v);'
	db   's=clamp(d[1]-d[0],0.,1.);'
	db   'f-=s;'
	db   'y*=clamp(s*12.,0.,1.);'
	db   'return f;'
	db '}'
	db 'vec3 d(vec3 d)'
	db '{'
	db   'float m;'
	db   'vec3 v=vec3(t(d+vec3(2e-4,0,0),m)-t(d-vec3(2e-4,0,0),m),t(d+vec3(0,2e-4,0),m)-t(d-vec3(0,2e-4,0),m),t(d+vec3(0,0,2e-4),m)-t(d-vec3(0,0,2e-4),m));'
	db   'return normalize(v);'
	db '}'
	db 'void d(out vec3 v,out vec3 s,vec2 d)'
	db '{'
	db   'float g=f;'
	db   'vec2 n=d;'
	db   'float i=n.x*n.x*.32+n.y*n.y;'
	db   'n=n*(7.-sqrt(37.5-11.5*i))/(i+1.);'
	db   'vec3 m=vec3(0,1.5,2);'
	db   's=m+vec3(-sin(6.2831853*g/20.),.75*cos(6.2831853*g/20.+.5),-cos(6.2831853*g/20.));'
	db   'm+=.075*vec3(t(vec3(2.*g,0,.5),0),t(vec3(2.*g,.1,.4),7),t(vec3(2.*g,.2,.3),9));'
	db   'i=.1*t(vec3(2.*g,0,0),13);'
	db   'm=normalize(m-s);'
	db   'vec3 y=normalize(cross(m,vec3(0,cos(i),sin(i))));'
	db   'v=normalize(n.x*y+n.y*normalize(cross(y,m))+m);'
	db '}'
	db 'vec3 d(vec3 s,vec3 d)'
	db '{'
	db   'float y=v(256.*d);'
	db   'return normalize(s+vec3(v(256.*(d+vec3(5e-4,0,0)))-y,v(256.*(d+vec3(0,5e-4,0)))-y,v(256.*(d+vec3(0,0,5e-4)))-y));'
	db '}'
	db 'void main()'
	db '{'
	db   'vec2 s=-1.+2.*gl_FragCoord.xy/n.xy;'
	db   'vec3 m,y;'
	db   'd(y,m,s);'
	db   'float f,z;'
	db   'vec3 g,i;'
	db   'for(f=.1;f<5.;)'
	db     '{'
	db       'i=m+f*y;'
	db       'float c=t(i,z);'
	db       'if(c<.001)'
	db         'break;'
	db       'f+=c*.12;'
	db     '}'
	db   'g=d(i);'
	db   'm=vec3(1.+.5*v(96.*i));'
	db   'g=d(g,.25*i);'
	db   'm=m*(vec3(.5,.55,.6)+vec3(.6,.5,.3)*clamp(dot(g,vec3(.8,.5,-.1)),0.,1.)*3.)*z/(1.+f)+vec3(1.06,1.14,1)*(1.-exp2(-.25*f));'
	db   'm=clamp((m*m+m)*.5*vec3(1,1.2,1),0.,1.)*(.5+.5*(1.-s.x)*(1.+s.x));'
	db   'gl_FragColor=vec4(m,1);'
	db '}', 0
