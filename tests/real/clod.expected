uniform vec2 d;uniform float s;uniform sampler2D y,v,c,e;float n(vec3 s){float v=(sin(s.x)+s.y*.25)*.35;s=vec3(cos(v)*s.x-sin(v)*s.y,sin(v)*s.x+cos(v)*s.y,s.z);return dot(cos(s)*cos(s),vec3(1))-1.2;}vec3 f(vec3 y){vec3 v=vec3(sin(s*1.5)*.5,cos(s)*.5,s);float m=0.,c,e;for(int s=0;s<75;s++){if(n(v+y*m)<0.){c=m-.125;e=m;for(int s=0;s<10;s++){m=(c+e)*.5;if(n(v+y*m)<0.)e=m;else c=m;}vec3 s=vec3(.1,0,0),p=v+y*m;s=-normalize(vec3(n(p+s),n(p+s.yxy),n(p+s.yyx))+vec3(sin(p*75.))*.01);return vec3(mix((max(-dot(s,vec3(.577)),0.)+.125*max(-dot(s,vec3(-.707,-.707,0)),0.))*(mod(length(p.xy)*20.,2.)<1.?vec3(.71,.85,.25):vec3(.79,.93,.4)),vec3(.93,.94,.85),vec3(pow(m/9.,5.))));}m+=.125;}return vec3(.93,.94,.85);}void main(){vec2 s=-1.+2.*gl_FragCoord.xy/d.xy;gl_FragColor=vec4(f(normalize(vec3(s.xy,1))),1);}
