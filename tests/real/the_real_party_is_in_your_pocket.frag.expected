                         "g=mix(.5+.5*cos(vec3(.8,.3,2)*(x+1.)),vec3(1),step(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(s(vec4(1.54,.53,.91,.72),v),s(vec4(.63,.78,.91,.72),v)),s(vec4(.61,1.675,.72,.64),v)),s(vec4(2.7,3.11,.72,.64),v)),s(vec4(3.45,3.65,.72,.64),v)),s(vec4(4.71,5.02,.72,.64),v)),s(vec4(5.3,5.51,.72,.64),v)),s(vec4(5.96,6.43,.72,.64),v)),s(vec4(3.2,1.27,.45,.35),v)),s(vec4(1.3,2.3,.45,.35),v)),s(vec4(2.58,4.2,.45,.35),v)),s(vec4(3.2,3.95,.35,.25),v)),s(vec4(5.2,5.93,.35,.25),v)),s(vec4(7.9,8.15,.35,.25),v)),s(vec4(.2,1.16,.32,.17),v)),max(length(v)-.84,-length(v)+.72)),max(length(v)-.52,-length(v)+.45)),max(length(v)-.17,-length(v)+.08)),0.))*vec3(1,1,.8)*(smoothstep(.1,.2,p.x)*smoothstep(.1,.2,p.y));"
                         "m+=l*3.*g;"
                         "c=vec3(.1);"
                       "}"
                   "}"
                 "}"
             "}"
           "if(g.y>3.&&g.y<3.2)"
             "c=vec3(.4);"
           "l*=c;"
           "y=a+x*2e-4;"
           "f=d;"
           "i=true;"
         "}"
       "else"
         "{"
           "vec3 c=v>1.5?"
             "vec3(1,.02,.2):"
             "v>.5?"
               "vec3(.2,1,.02):"
               "vec3(.02,.2,1);"
           "if(s()>mix(.2,1.,r))"
             "{"
               "if(g.y>1.5)"
                 "c=vec3(.02);"
               "l*=c;"
               "y=a+x*2e-4;"
               "f=d;"
               "i=true;"
             "}"
           "else"
             "{"
               "if(i)"
                 "break;"
               "l*=g.y>1.5?"
                 "vec3(.5):"
                 ".9*mix(c,vec3(1),.25);"
               "y=a+x*2e-4;"
               "f=reflect(f,x)+(vec3(s(),s(),s())-.5)*.4;"
             "}"
         "}"
       "if(max(l.x,max(l.y,l.z))<.001)"
         "break;"
     "}"
   "return m;"
 "}"
 "void main()"
 "{"
   "vec3 y=vec3(0);"
   "for(int z=0;z<16;++z)"
     "{"
       "f=float(z)+gl_TexCoord[0].x*16.;"
       "float i=s()*6.28319;"
       "vec2 l=vec2(cos(i),sin(i))*sqrt(1.-sqrt(1.-s()))*1.2;"
       "if(int(f)%4==0)"
         "l*=15.*length(l);"
       "y+=d(vec3((gl_FragCoord.xy-vec2(960,540)+l)/540.,-3.5))/48.;"
     "}"
   "y/=(y+1.)/2.;"
   "gl_FragColor.xyz=pow(y+.01*vec3(1,1,.5),vec3(1./2.2))+s()/1e2;"
 "}";

