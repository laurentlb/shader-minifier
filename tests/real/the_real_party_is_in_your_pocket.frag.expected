                         "i=mix(.5+.5*cos(vec3(.8,.3,2)*(a+1.)),vec3(1),step(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(d(vec4(1.54,.53,.91,.72),y),d(vec4(.63,.78,.91,.72),y)),d(vec4(.61,1.675,.72,.64),y)),d(vec4(2.7,3.11,.72,.64),y)),d(vec4(3.45,3.65,.72,.64),y)),d(vec4(4.71,5.02,.72,.64),y)),d(vec4(5.3,5.51,.72,.64),y)),d(vec4(5.96,6.43,.72,.64),y)),d(vec4(3.2,1.27,.45,.35),y)),d(vec4(1.3,2.3,.45,.35),y)),d(vec4(2.58,4.2,.45,.35),y)),d(vec4(3.2,3.95,.35,.25),y)),d(vec4(5.2,5.93,.35,.25),y)),d(vec4(7.9,8.15,.35,.25),y)),d(vec4(.2,1.16,.32,.17),y)),max(length(y)-.84,-length(y)+.72)),max(length(y)-.52,-length(y)+.45)),max(length(y)-.17,-length(y)+.08)),0.))*vec3(1,1,.8)*(smoothstep(.1,.2,p.x)*smoothstep(.1,.2,p.y));"
                         "l+=z*3.*i;"
                         "m=vec3(.1);"
                       "}"
                   "}"
                 "}"
             "}"
           "if(g.y>3.&&g.y<3.2)"
             "m=vec3(.4);"
           "z*=m;"
           "i=v+c*2e-4;"
           "f=p;"
           "y=true;"
         "}"
       "else"
         "{"
           "vec3 m=a>1.5?"
             "vec3(1,.02,.2):"
             "a>.5?"
               "vec3(.2,1,.02):"
               "vec3(.02,.2,1);"
           "if(d()>mix(.2,1.,r))"
             "{"
               "if(g.y>1.5)"
                 "m=vec3(.02);"
               "z*=m;"
               "i=v+c*2e-4;"
               "f=p;"
               "y=true;"
             "}"
           "else"
             "{"
               "if(y)"
                 "break;"
               "z*=g.y>1.5?"
                 "vec3(.5):"
                 ".9*mix(m,vec3(1),.25);"
               "i=v+c*2e-4;"
               "f=reflect(f,c)+(vec3(d(),d(),d())-.5)*.4;"
             "}"
         "}"
       "if(max(z.x,max(z.y,z.z))<.001)"
         "break;"
     "}"
   "return l;"
 "}"
 "void main()"
 "{"
   "vec3 l=vec3(0);"
   "for(int z=0;z<16;++z)"
     "{"
       "f=float(z)+gl_TexCoord[0].x*16.;"
       "float a=d()*6.28319;"
       "vec2 y=vec2(cos(a),sin(a))*sqrt(1.-sqrt(1.-d()))*1.2;"
       "if(int(f)%4==0)"
         "y*=15.*length(y);"
       "l+=s(vec3((gl_FragCoord.xy-vec2(960,540)+y)/540.,-3.5))/48.;"
     "}"
   "l/=(l+1.)/2.;"
   "gl_FragColor.xyz=pow(l+.01*vec3(1,1,.5),vec3(1./2.2))+d()/1e2;"
 "}";

#endif // THE_REAL_PARTY_IS_IN_YOUR_POCKET_FRAG_EXPECTED_
