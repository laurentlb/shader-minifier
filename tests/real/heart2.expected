{"mappings":{"mouse":"f","resolution":"y","time":"s"},"shaders":{"tests/real/heart2.frag":"uniform float s;uniform vec2 y;uniform vec4 f;void main(){vec2 f=(2.*gl_FragCoord.xy-y)/y.y;float g=mod(s,2.)/2.,v=pow(g,.2)*.5+.5;v-=v*.2*sin(g*6.2831*5.)*exp(-g*6.);f*=vec2(.5,1.5)+v*vec2(.5,-.5);g=atan(f.x,f.y)/3.141593;v=length(f);g=abs(g);g=(13.*g-22.*g*g+10.*g*g*g)/(6.-5.*g);gl_FragColor=vec4(step(v,g)*pow(1.-v/g,.25),0,0,1);}"}}
